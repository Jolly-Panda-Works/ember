{
  "name": "ember",
  "productName": "Ember",
  "version": "1.0.0",
  "description": "Ember - launcher for your Node projects",
  "main": "main.js",
  "author": "Usef Farahmand",
  "license": "MIT",
  "homepage": "https://github.com/Jolly-Panda-Works/ember",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jolly-Panda-Works/ember.git"
  },
  "bugs": {
    "url": "https://github.com/Jolly-Panda-Works/ember/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check updates.js && node --check projectwatch.js && node --check ports.js && node --check netinfo.js && node --check src/i18n.js && node --check src/common.js && node --check src/app.js && node --check src/project.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.ember.launcher",
    "productName": "Ember",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ports.js",
      "netinfo.js",
      "updates.js",
      "projectwatch.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ember-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Ember-Portable.${ext}"
    },
    "copyright": "Copyright (c) 2026 Usef Farahmand"
  }
}
